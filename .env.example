# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=llm_lens

# Provider
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
USE_MOCK=true

# Proxy auth (X-LLM-Lens-Key header)
LENS_API_KEY=dev-key

# Drift job
DRIFT_INTERVAL_SECS=300
